{
  "name": "Qubiva Demo",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [80],
  "portsAttributes": {
    "80": {
      "label": "Qubiva",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "docker compose pull",
  "postStartCommand": "docker compose up -d && echo '\n  Qubiva is starting...\n  Login: admin@qubiva.local / Demo@2026\n'",
  "waitFor": "postCreateCommand"
}
