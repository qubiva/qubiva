{
  "name": "Qubiva Demo",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Qubiva",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "docker compose pull",
  "postStartCommand": "docker compose up -d && echo '\\n  Qubiva is starting at port 8000...\\n  Login: admin@qubiva.local / Demo@2026\\n'",
  "waitFor": "postCreateCommand"
}
