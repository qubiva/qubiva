/* Kanban Board */
.kanban-board {
    display: flex;
    min-height: 70vh;
    margin-bottom: 20px;
}
.kanban-column {
    flex: 1;
    margin: 0 10px;
}
.kanban-column .card {
    height: auto; /* Adjust height automatically to fit content */
    display: block; /* Change flex to block for auto height */
}
.kanban-column .card-body {
    flex: 1;
    overflow-y: auto;
    padding: 10px;
}
.task-card {
    margin-bottom: 10px;
    cursor: move;
}

/* Enhanced modal styles */
.modal-body {
    max-height: 70vh;
    overflow-y: auto;
}
#task-form {
    border-bottom: 1px solid #ccc;
    padding-bottom: 15px;
    margin-bottom: 15px;
}
.form-group {
    margin-bottom: 1rem;
}

/* Styles for the discussion section */
.comment {
    border-bottom: 1px solid #ddd;
    padding: 8px 0;
}
.comment:last-child {
    border-bottom: none;
}
.comment-author {
    font-weight: bold;
}
.comment-timestamp {
    font-size: 0.85rem;
    color: #888;
}

/* Sprint styles */
#sprint-modal .modal-body {
    max-height: 60vh;
    overflow-y: auto;
}
